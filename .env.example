# Los datasets son publicos en el plan gratuito de Sanity, asi que la lectura
# del menu NO necesita token. Esta variable solo hace falta si algun dia se
# pasa a datasets privados o se agregan previews de borradores.
# SANITY_API_READ_TOKEN=

# Se usa para construir URLs absolutas (QR, Open Graph).
PUBLIC_SITE_URL=http://localhost:4321

# Token de ESCRITURA para cargar contenido en Sanity desde scripts.
# Las lecturas del menu no lo necesitan (el dataset es publico), las escrituras
# siempre si. Se crea en sanity.io/manage -> API -> Tokens, con permiso Editor.
# Nunca se commitea: .env esta en .gitignore.
# SANITY_WRITE_TOKEN=
