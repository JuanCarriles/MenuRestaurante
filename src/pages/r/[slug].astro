---
import MenuUnavailable from '~/components/MenuUnavailable.astro';
import { clientFor } from '~/lib/sanity';
import { MENU_QUERY, type RestaurantData } from '~/lib/queries';
import { today } from '~/lib/format';
import { getDesign } from '~/restaurants';
import { getTenant } from '~/tenants';
import '~/styles/global.css';

export const prerender = false;

/**
 * Despachador. No dibuja nada del menu: resuelve el restaurante, trae los
 * datos con la query compartida, resuelve los estados de error y delega el
 * render al diseño a medida de ese local (src/restaurants/).
 */

const { slug } = Astro.params;
const tenant = getTenant(slug);
const design = getDesign(slug);

if (!tenant || !design) {
  return new Response('Restaurante no encontrado', { status: 404 });
}

const client = clientFor(tenant);

let sanityData: RestaurantData | null = null;
let failed = false;

try {
  sanityData = await client.fetch<RestaurantData | null>(MENU_QUERY, {
    today: today(tenant.timezone),
  });
} catch {
  // Quien escanea el QR esta sentado en una mesa: nunca debe ver un stack trace.
  failed = true;
}

// Sanity es la unica fuente de verdad: no hay menu de respaldo. Si el
// contenido no esta publicado o Sanity no responde, se muestra un cartel
// entendible, nunca datos viejos que puedan contradecir a la carta impresa.
const sanityUsable = sanityData?.published === true && (sanityData.menu?.length ?? 0) > 0;

const data: RestaurantData | null = sanityUsable ? sanityData : null;

// Sin datos y sin respaldo hay que decir por que: 503 si Sanity no respondio
// (reintentar sirve), 404 si simplemente no hay menu publicado (no sirve).
if (!data) {
  Astro.response.status = failed ? 503 : 404;
}

const Menu = design.component;
const title = data?.name ? `Menú de ${data.name}` : 'Menú';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {data?.tagline && <meta name="description" content={data.tagline} />}
    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={design.fontLink} />

    <style is:inline set:html={design.themeCss}></style>
  </head>

  <body>
    {
      data ? (
        <Menu data={data} slug={slug!} client={client} />
      ) : (
        <MenuUnavailable failed={failed} />
      )
    }
  </body>
</html>
