---
export interface Props {
  tags?: string[];
}
const tags = Astro.props.tags ?? [];

const ICONS: Record<string, { label: string; svg: string }> = {
  vegan: {
    label: 'Vegano',
    svg: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 21c0-7-4-13-9-15 5 2 9 8 9 15z" opacity="0.85"/><path d="M12 21V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>`,
  },
  vegetariano: {
    label: 'Vegetariano',
    svg: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22V12"/><path d="M12 12c-3-3-7-3-9 0 2-1 6-1 9 0z"/><path d="M12 12c3-3 7-3 9 0-2-1-6-1-9 0z"/></svg>`,
  },
  'sin-tacc': {
    label: 'Sin TACC',
    svg: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v18M8 6c0 3-2 6-2 9M16 6c0 3 2 6 2 9"/><path d="M8 10c1 0 2-1 2-2M16 10c-1 0-2-1-2-2"/><line x1="4" y1="4" x2="20" y2="20"/></svg>`,
  },
  picante: {
    label: 'Picante',
    svg: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M15.5 3c1.5 1.5 2.5 4 2.5 6 0 4-3 7-7 7S4 13 4 9c0-2 1-4.5 2.5-6 1 2 3 3 5 3s4-1 5-3z"/><path d="M12 16v5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>`,
  },
  'sin-lactosa': {
    label: 'Sin lactosa',
    svg: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 4h8l2 5v11a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V9l2-5z"/><path d="M9 4v18M15 4v18"/><line x1="4" y1="4" x2="20" y2="20"/></svg>`,
  },
};

const present = tags
  .map((t) => t.toLowerCase().trim())
  .filter((t) => ICONS[t])
  .slice(0, 5);
---

{
  present.length > 0 && (
    <ul class="allergen-list" aria-label="Alergenos y preferencias">
      {present.map((tag) => (
        <li class="allergen-icon" title={ICONS[tag].label} set:html={ICONS[tag].svg} />
      ))}
    </ul>
  )
}
